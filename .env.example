# Copy this file to .env and fill in your own secrets.
# NEVER commit .env to GitHub.

JARVIS_LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=put_your_openrouter_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Optional tuning
JARVIS_MAX_HISTORY=12
JARVIS_TEMPERATURE=0.2
JARVIS_TIMEOUT=90
JARVIS_MAX_OUTPUT=1600
JARVIS_CACHE_TTL=300

# Optional Telegram
TELEGRAM_BOT_TOKEN=
