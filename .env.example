# Copy to .env. Never commit real secrets.
JARVIS_LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Models verified on OpenRouter in Sep 2026
JARVIS_MODEL=z-ai/glm-5.3-flash
JARVIS_FALLBACK_MODEL=deepseek/deepseek-v4-flash-0731

JARVIS_MAX_HISTORY=20
JARVIS_TEMPERATURE=0.2
JARVIS_TIMEOUT=45
JARVIS_MAX_OUTPUT=1600
# 0 = no application-level answer cache; recommended for an assistant with live tools.
JARVIS_CACHE_TTL=0

# Optional Telegram
TELEGRAM_BOT_TOKEN=
