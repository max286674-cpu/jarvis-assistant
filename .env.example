# Copy to .env. Never commit real secrets.
JARVIS_LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Main / fallback / routing
JARVIS_MODEL=z-ai/glm-5.3-flash
JARVIS_FALLBACK_MODEL=deepseek/deepseek-v4-flash-0731
JARVIS_CHEAP_MODEL=deepseek/deepseek-v4-flash-0731
JARVIS_RESEARCH_MODEL=z-ai/glm-5.3-flash
JARVIS_MAX_HISTORY=20
JARVIS_TEMPERATURE=0.2
JARVIS_TIMEOUT=45
JARVIS_MAX_OUTPUT=1600
JARVIS_CACHE_TTL=0

# Optional local voice stack (install requirements-voice.txt)
JARVIS_WHISPER_MODEL=small
JARVIS_WHISPER_DEVICE=cpu
JARVIS_WHISPER_COMPUTE=int8

# Optional Playwright browser executable; leave empty to use bundled Chromium
JARVIS_BROWSER_EXECUTABLE=

# Optional Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
